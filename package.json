{
  "name": "wainwright-fun",
  "version": "1.0.0",
  "private": true,
  "description": "Kids iPad allowed-apps website and restriction profile",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/fetch-icons.ts && vite",
    "dev:admin": "bash scripts/dev-admin.sh",
    "dev:admin:raw": "vite --config admin/vite.config.ts",
    "fetch-icons": "tsx scripts/fetch-icons.ts",
    "build": "tsx scripts/build.ts",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:snacks": "vite build --config snacks/vite.config.ts",
    "dev:snacks": "vite --config snacks/vite.config.ts",
    "build:tickets": "vite build --config tickets/vite.config.ts",
    "dev:tickets": "vite --config tickets/vite.config.ts",
    "check-bundle-ids": "tsx scripts/check-bundle-ids.ts",
    "verify-min-age": "tsx scripts/verify-min-age.ts",
    "extract-system-icons": "tsx scripts/extract-system-icons.ts",
    "preview": "npm run build && vite preview",
    "deploy": "bash scripts/deploy.sh",
    "cdk": "cdk",
    "synth": "cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1098.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-secrets-manager": "^3.1098.0",
    "@aws-sdk/client-sqs": "^3.1098.0",
    "@aws-sdk/lib-dynamodb": "^3.1098.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "js-yaml": "^4.1.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "aws-cdk": "^2.175.0",
    "aws-cdk-lib": "^2.175.0",
    "constructs": "^10.4.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
