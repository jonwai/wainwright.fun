{
  "name": "wainwright.fun",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kids iPad allowed-apps website and restriction profile",
  "packageManager": "pnpm@8.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @wainwright/kids dev",
    "dev:admin": "bash tools/dev-admin.sh",
    "dev:admin:raw": "pnpm --filter @wainwright/admin dev",
    "dev:snacks": "pnpm --filter @wainwright/snacks dev",
    "dev:tickets": "pnpm --filter @wainwright/tickets dev",
    "dev:twin": "pnpm --filter @wainwright/twin dev",
    "dev:chores": "pnpm --filter @wainwright/chores dev",
    "build": "pnpm --filter @wainwright/kids build",
    "build:admin": "pnpm --filter @wainwright/admin build",
    "build:snacks": "pnpm --filter @wainwright/snacks build",
    "build:tickets": "pnpm --filter @wainwright/tickets build",
    "build:twin": "pnpm --filter @wainwright/twin build",
    "build:chores": "pnpm --filter @wainwright/chores build",
    "build:all": "pnpm --filter \"./apps/*\" build",
    "preview": "pnpm --filter @wainwright/kids preview",
    "fetch-icons": "tsx packages/infra/scripts/fetch-icons.ts",
    "check-bundle-ids": "tsx packages/infra/scripts/check-bundle-ids.ts",
    "verify-min-age": "tsx packages/infra/scripts/verify-min-age.ts",
    "extract-system-icons": "tsx packages/infra/scripts/extract-system-icons.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/infra/tsconfig.json",
    "test:routes": "tsx tools/test-budget-routes.ts && tsx tools/test-chore-routes.ts && tsx tools/test-rollover.ts && tsx tools/test-task-routes.ts",
    "deploy": "bash tools/deploy.sh",
    "cdk": "cd packages/infra && cdk --app \"npx tsx bin/app.ts\"",
    "synth": "cd packages/infra && cdk synth --app \"npx tsx bin/app.ts\"",
    "deploy:cdk": "cd packages/infra && cdk deploy --all --require-approval never"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.175.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1098.0",
    "@aws-sdk/lib-dynamodb": "^3.1098.0"
  }
}
