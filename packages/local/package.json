{
  "name": "@wainwright/local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "wainwright.fun on the home Mac: the tickets API (hosted task routes on Postgres) behind IP identity",
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/main.mjs",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "import:hosted": "tsx src/import-hosted.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1098.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/lib-dynamodb": "^3.1098.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
