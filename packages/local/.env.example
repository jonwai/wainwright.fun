# Home Assistant homework mode. See README.md in this package for the compose mounts.
# HA_URL defaults to https://home.wainwright.fun when unset.
HA_URL=https://home.wainwright.fun
# Long-lived Home Assistant token. The kids' browser never receives it.
HA_TOKEN_FILE=/run/ha-tokens/ha_token
# Bearer token for GET /api/ha/homework-domains.
HA_HOMEWORK_DOMAINS_TOKEN_FILE=/run/ha-tokens/homework_domains_token
