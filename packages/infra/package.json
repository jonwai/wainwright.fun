{
  "name": "@wainwright/infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK stacks + Lambda handlers + deploy/migration scripts",
  "scripts": {
    "cdk": "cdk --app \"tsx bin/app.ts\"",
    "synth": "cdk synth --app \"tsx bin/app.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1098.0",
    "@aws-sdk/client-dynamodb": "^3.1098.0",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/client-secrets-manager": "^3.1098.0",
    "@aws-sdk/client-sqs": "^3.1098.0",
    "@aws-sdk/lib-dynamodb": "^3.1098.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "@wainwright/shared": "workspace:*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.175.0",
    "aws-cdk-lib": "^2.175.0",
    "constructs": "^10.4.2",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
